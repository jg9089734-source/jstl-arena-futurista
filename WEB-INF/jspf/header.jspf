<%-- ================== HUD / cabecera ARENA ================== --%>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${empty arenaTitulo ? 'JSTL//ARENA' : arenaTitulo}" /> | JSTL//ARENA</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&family=Rajdhani:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="${ctx}/css/gamer.css">
</head>
<body data-ctx="${ctx}">

  <canvas id="arena-particles" aria-hidden="true"></canvas>
  <div class="grid-overlay" aria-hidden="true"></div>
  <div class="scanline" aria-hidden="true"></div>

  <header class="hud">
    <a class="hud-brand" href="${ctx}/index.jsp">
      <span class="hud-logo"><i class="bi bi-controller"></i></span>
      <span class="glitch" data-text="JSTL//ARENA">JSTL//ARENA</span>
    </a>

    <nav class="hud-nav">
      <a class="btn-neon btn-neon-sm" href="${ctx}/index.jsp">
        <i class="bi bi-house-door-fill"></i> Inicio
      </a>
      <c:if test="${not empty arenaNivel and arenaNivel > 0}">
        <span class="hud-chip"><i class="bi bi-box-arrow-in-right"></i> Nivel <c:out value="${arenaNivel}" /></span>
      </c:if>
    </nav>

    <div class="hud-progress" title="Progreso del jugador">
      <span class="hud-lvl">LVL <b id="arena-lvl">0</b>/8</span>
      <div class="xp"><div class="xp-fill" id="arena-xp"></div></div>
      <span class="hud-xp"><b id="arena-xp-txt">0</b> XP</span>
    </div>
  </header>

  <main class="arena-main">

  <c:if test="${not empty arenaCompletar}">
    <span id="arena-complete" data-nivel="${arenaCompletar}" hidden></span>
  </c:if>
